# Copy to .env.local and fill in. Never commit .env.local.

# ─── Sanity ──────────────────────────────────────────────
# The website reads project/dataset from src/sanity/env.ts.
# These are used by the seed/migration scripts in /scripts.
NEXT_PUBLIC_SANITY_PROJECT_ID="your_project_id_here"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-02-24"
# Write token for the scripts only — the website never needs it.
# (A few older scripts read SANITY_WRITE_TOKEN or SANITY_TOKEN instead.)
SANITY_API_TOKEN=

# ─── Contact + group inquiry forms (/api/contact) ────────
RESEND_API_KEY=
# Google Apps Script web-app URL that appends a row to the enquiries sheet
GOOGLE_SHEET_WEBHOOK=
# Inbox that receives enquiries
CONTACT_EMAIL=

# ─── RMK memories gallery (/en/rmk-japan-2026) ───────────
MEMORIES_GALLERY_PASSWORD=
# Long random value stored in the visitor's cookie. Changing it logs everyone out.
# Generate one with:  openssl rand -hex 32
MEMORIES_SESSION_TOKEN=
MEMORIES_DRIVE_FOLDER_ID=
# Google Drive API v3 key (for the in-page gallery)
GOOGLE_DRIVE_API_KEY=
